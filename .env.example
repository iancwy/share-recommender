# Copy this file to .env and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# The "anon" / "publishable" key. It is safe to use in the app because
# row-level security limits every query to the signed-in user's rows.
# Never put the service_role / secret key in this file.
SUPABASE_ANON_KEY=

# Market data provider. Only "yahoo" exists for now.
MARKET_DATA_PROVIDER=yahoo

# Default exchange preselected in the holdings form (ASX, NYSE, NASDAQ, LSE, ...).
DEFAULT_EXCHANGE=ASX

# Optional: Anthropic API key for plain-English explanations of recommendations
# (console.anthropic.com > API Keys). Without it the app shows the rules' own reasons.
ANTHROPIC_API_KEY=
