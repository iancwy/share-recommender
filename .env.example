# Copy this file to .env and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# The "anon" / "publishable" key. It is safe to use in the app because
# row-level security limits every query to the signed-in user's rows.
# Never put the service_role / secret key in this file.
SUPABASE_ANON_KEY=

# Market data provider. Only "yahoo" exists for now.
MARKET_DATA_PROVIDER=yahoo

# Default exchange preselected in the holdings form (ASX, NYSE, NASDAQ, LSE, ...).
DEFAULT_EXCHANGE=ASX

# Anthropic API key (console.anthropic.com > API Keys). The Picker page needs it: Claude
# ranks the screen's shortlist. It also turns on the chat interview and plain-English
# explanations. Without it the rest of the app works, and the Picker shows the screen unranked.
ANTHROPIC_API_KEY=

# --- Only for running the notification job locally (python -m share_recommender.jobs.notify).
# The app never reads these. In production they are GitHub Actions secrets; the service key
# bypasses row-level security, so never commit it or put it in Streamlit secrets.
# SUPABASE_SERVICE_ROLE_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# APP_URL=http://localhost:8501
